# Copy this file to .env and fill in ONLY the placeholders locally.
# Real environment variables take precedence over values in .env.

# Storage: "sheets" (default, required for Render) or "local" (offline dev only).
CONTACT_STORAGE=sheets

# Google Sheets cloud message store.
# Share the private sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_WITH_GOOGLE_SHEET_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# Gmail SMTP - use a 16-character Google App Password, not your account password.
CONTACT_EMAIL_TO=binesa1110@gmail.com
CONTACT_EMAIL_FROM=binesa1110@gmail.com
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=binesa1110@gmail.com
CONTACT_SMTP_PASS=PASTE_GOOGLE_APP_PASSWORD_HERE

# Authorizes GET /api/admin/messages.docx. Use a long random value you generate locally.
CONTACT_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
